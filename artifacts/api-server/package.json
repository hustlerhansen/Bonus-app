{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:v2": "node --experimental-strip-types --test test/v2-access.test.mts",
    "test:demo-financial": "node --test test/demo-financial.test.mjs",
    "test:v2-points": "node --test test/v2-points.test.mjs",
    "test:v2-offers": "node --test test/v2-offers.test.mjs",
    "test:v2-rewards": "node --test test/v2-rewards.test.mjs",
    "test:v2-admin": "node --test test/v2-admin-requests.test.mjs",
    "test:v2-economy": "node --test test/v2-economy.test.mjs",
    "points:reconcile": "node scripts/reconcile-points.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.76",
    "@clerk/shared": "^4.39.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
